# robot-twin reverse proxy (Caddy), installed to /etc/caddy/Caddyfile.
#
# One origin for the browser: the built twin, /robot-ws (robot server) and
# /vision/* (vision service, prefix stripped). The backends listen on
# 127.0.0.1 only; this is the only way in from the LAN.
#
# Access: only TWIN_ALLOWED_CIDRS (from /etc/robot-twin/caddy.env). There is no
# login: anyone in those networks can drive the robot once it is enabled.
# Keep the list to the operator network. For HTTPS, use a site name and
# `tls internal` (the browser must trust Caddy's CA).
:{$TWIN_PORT:5909} {
	@denied not remote_ip {$TWIN_ALLOWED_CIDRS:127.0.0.1/32}
	respond @denied "forbidden" 403

	handle /robot-ws* {
		reverse_proxy 127.0.0.1:3001
	}

	# The vision service serves /stream, /detect, /board at its root.
	handle_path /vision/* {
		reverse_proxy 127.0.0.1:8081 {
			flush_interval -1
		}
	}

	handle {
		root * /opt/robot-twin/twin
		file_server
	}
}
