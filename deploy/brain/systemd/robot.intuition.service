[Unit]
Description=Robot brain - intuition network (searchless_chess, CPU)
After=network.target

[Service]
User=@USER@
Environment=SEARCHLESS_ROOT=@PREFIX@/searchless
Environment=SEARCHLESS_MODEL=9M
Environment=INTUITION_HOST=127.0.0.1
Environment=INTUITION_PORT=8095
# Leave cores for vision and the controller: XLA uses all cores by default.
CPUQuota=300%
ExecStart=@PREFIX@/intuition-venv/bin/python -I @REPO@/apps/intuition/intuition_server.py serve
Restart=on-failure

[Install]
WantedBy=multi-user.target
