[Unit]
Description=robot-twin robot server (controller, chess loop with the brain, twin WebSocket)
After=robot-franka.service robot-vision.service robot-intuition.service robot-reflection.service
Wants=robot-franka.service robot-vision.service robot-intuition.service robot-reflection.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=robot-twin
Group=robot-twin
EnvironmentFile=/etc/robot-twin/robot-twin.env
WorkingDirectory=/opt/robot-twin/app/apps/server
ExecStart=/opt/robot-twin/node/bin/node --import tsx src/index.ts
# On restart the controller starts DISABLED and reads the robot pose again.
Restart=on-failure
RestartSec=3
Nice=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# The chess loop's JSONL log (BRAIN_LOG).
ReadWritePaths=/var/lib/robot-twin/brain
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
