[Unit]
Description=robot-twin ROS 2 stack (Franka + MoveIt + ws_bridge)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=robot-twin
EnvironmentFile=/etc/robot-twin.env
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash && source /home/robot-twin/ros_ws/install/setup.bash && ros2 launch ws_bridge stack.launch.py'
Restart=on-failure
RestartSec=5
# FCI needs a real-time scheduler for libfranka; keep the stack on nice.
Nice=-10

[Install]
WantedBy=multi-user.target
