# robot-twin configuration. install.sh copies this file to
# /etc/robot-twin/robot-twin.env (mode 0640, root:robot-twin) once and never
# overwrites it. Edit the installed copy.
#
# This file holds NO secrets. Do not put a secret here.
# Lines marked MUST-SET have a placeholder that you must check on site.

# --- Robot (Franka Panda control unit, FCI) ----------------------------------
# MUST-SET: IP of the Panda CONTROL unit on the shop-floor port (Desk shows it).
FRANKA_HOST=172.16.0.2
# 1 = no robot connection, simulated arm (safe default). 0 = real robot.
FRANKA_DRY_RUN=1
# 1 = use the Franka Hand. 0 = no gripper attached.
FRANKA_GRIPPER=1
# Speed factor of panda-py joint moves (fraction of the joint limits).
# Start at 0.05-0.1. The bridge caps it at FRANKA_SPEED_FACTOR_MAX (<= 0.5).
FRANKA_SPEED_FACTOR=0.1
FRANKA_SPEED_FACTOR_MAX=0.3
# Heartbeat timeout: the bridge stops the arm when the server is silent this long.
FRANKA_LEASE_TIMEOUT_S=1.0
# Table plane in the robot base frame (m). 0 when the base stands on the table.
FRANKA_TABLE_Z_M=0.0
# Grasp: target width (m), tolerances (m) and force (N, capped at 70).
FRANKA_GRASP_WIDTH_M=0.02
FRANKA_GRASP_EPS_INNER_M=0.015
FRANKA_GRASP_EPS_OUTER_M=0.03
FRANKA_GRASP_FORCE_N=20
FRANKA_BRIDGE_HOST=127.0.0.1
FRANKA_BRIDGE_PORT=3002
FRANKA_LOCK_FILE=/run/robot-twin/franka.lock
FRANKA_LIMITS_FILE=/opt/robot-twin/app/packages/robot-config/panda-limits.json

# --- FCI network (used by deploy/setup-fci-network.sh and preflight.sh) -------
# MUST-SET: name of the dedicated NIC wired to the control unit (ip -br link).
FCI_NIC=enp0s0-CHANGE-ME
# MUST-SET: address of the NUC on that NIC, same /24 as FRANKA_HOST.
FCI_HOST_CIDR=172.16.0.1/24

# --- Robot server (Node) ------------------------------------------------------
# simulated | franka. "franka" talks to the bridge above (dry-run or real).
ROBOT_ADAPTER=franka
FRANKA_BRIDGE_URL=http://127.0.0.1:3002
PORT=3001
ROBOT_WS_HOST=127.0.0.1
# Chess loop (apps/server/src/chess.ts). ONE loop: the brain decides, the
# controller moves the arm, the camera checks before and after every move.
# The loop is stopped at server start: a person presses Start in the twin.
VISION_URL=http://127.0.0.1:8081
# Camera check: vision = GET /board (calibrated occupancy, default),
# observe = GET /observe (piece detector, VISION_OBSERVE_MODEL), sim = the
# simulated board (dry-run only; refused with CHESS_REQUIRE_VISION=1).
BRAIN_OBSERVER=vision
CHESS_REQUIRE_VISION=1
# The loop refuses to run without a valid saved calibration (Calibrate wizard).
# Default: required when VISION_URL is set or the robot is real. 0 only for the
# first dry-run without a camera.
#CHESS_REQUIRE_CALIBRATION=1
CHESS_SETTLE_MS=500
# Optional: 7 comma-separated radians, a pose where the arm does not hide the
# board from the camera. Empty = ready pose turned 90 deg about joint1.
CHESS_OBSERVE_POSE=
BRAIN_ROBOT_COLOR=b
# Below this per-square confidence a camera label is reported as uncertain.
BRAIN_MIN_CONFIDENCE=0.6
BRAIN_POLL_MS=500
BRAIN_COMMENTARY=0
# One JSON line per cycle (prediction, observation, diff, decision, reasons).
BRAIN_LOG=/var/lib/robot-twin/brain/brain.jsonl

# --- Brain (deploy/brain/install-brain.sh, docs/BRAIN.md) ---------------------
# No chess engine: intuition = a searchless policy network, reflection = a
# small LM that chooses among its candidates. No secrets here: a key is only
# ever a FILE PATH (*_KEY_FILE).
# Intuition: searchless (robot-intuition.service) | maia | learned | uniform.
BRAIN_INTUITION=searchless
INTUITION_URL=http://127.0.0.1:8095
INTUITION_TIMEOUT_MS=30000
INTUITION_TOPK=5
INTUITION_TEMPERATURE=0
# Maia only (BRAIN_INTUITION=maia, install with WITH_MAIA=1; lc0 runs nodes 1).
#INTUITION_MAIA_WEIGHTS=/opt/robot-twin/brain/maia/maia-1500.pb.gz
#INTUITION_LC0_PATH=/opt/robot-twin/brain/lc0/build/release/lc0
#INTUITION_LC0_BACKEND=
#INTUITION_LC0_THREADS=1
#INTUITION_LEARNED_MODEL=
# Reflection: local (robot-reflection.service) | remote (fleet LLM) | off.
BRAIN_REFLECTION=local
REFLECTION_URL=http://127.0.0.1:8090/v1
REFLECTION_MODEL=qwen3-1.7b
REFLECTION_TIMEOUT_MS=20000
REFLECTION_THINKING=0
#REFLECTION_MAX_TOKENS=160
#REFLECTION_KEY_FILE=
# Remote reflection only (off by default).
#FLEET_LLM_URL=
#FLEET_LLM_MODEL=
#FLEET_LLM_KEY_FILE=

# --- Vision -------------------------------------------------------------------
VISION_HOST=127.0.0.1
VISION_PORT=8081
# MUST-SET: camera index (ls /dev/video*; v4l2-ctl --list-devices).
VISION_CAMERA_INDEX=0
# Optional instead of the index: "synthetic" (dev only) or a video file path.
#VISION_CAMERA_SOURCE=
# The Calibrate wizard writes this file (versions in calibration.d/ next to
# it); the robot server reads the same file. One source of truth.
VISION_CALIBRATION_FILE=/var/lib/robot-twin/vision/calibration.json
VISION_REFERENCE_FILE=/var/lib/robot-twin/vision/reference.png
# Defaults only, used before the first wizard calibration (the saved board
# pose overrides them): twin-frame a1 corner (mm), square size, board yaw.
VISION_BOARD_ORIGIN_X=600
VISION_BOARD_ORIGIN_Y=0
VISION_BOARD_ORIGIN_Z=-160
VISION_BOARD_SQUARE_SIZE=40
VISION_BOARD_ROTATION_DEG=0
VISION_BOARD_PICKUP_Z=45
# Piece detector of GET /observe (BRAIN_OBSERVER=observe, dataset capture):
# a YOLO .pt/.onnx/*_openvino_model path; empty = colour heuristic.
VISION_OBSERVE_MODEL=
#VISION_OBSERVE_MIN_CONF=0.25
#VISION_OBSERVE_EMPTY_CONF=0.9
#VISION_OBSERVE_ANCHOR=0.5

# --- Optional ROS 2 path (install.sh --with-ros only) -------------------------
BRIDGE_ARM_ID=panda
BRIDGE_MOVE_GROUP=panda_arm
BRIDGE_EE_LINK=panda_hand
BRIDGE_WS_PORT=3101
BRIDGE_EXPERIMENTAL_MOTION=0
