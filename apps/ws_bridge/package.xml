<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ws_bridge</name>
  <version>0.1.0</version>
  <description>OPTIONAL WebSocket bridge between the robot-twin UI and MoveIt for the Franka Panda (not part of the v1 deployment).</description>
  <maintainer email="dev@rde.local">RDE robot-twin</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <!-- websockets >= 10.4 from pip: the Ubuntu 22.04 apt package (9.1) fails on
       Python 3.10 (asyncio.Lock(loop=...)). deploy/install.sh installs it. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- franka_moveit_config comes from a franka_ros2 source build (not in rosdep). -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
