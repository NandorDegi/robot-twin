{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "calibrate": "tsx src/cli/calibrate.ts"
  },
  "dependencies": {
    "@robot/brain": "workspace:*",
    "@robot/chess": "workspace:*",
    "@robot/hardware": "workspace:*",
    "@robot/kinematics": "workspace:*",
    "@robot/protocol": "workspace:*",
    "@robot/robot-config": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
