{
  "name": "robot-twin",
  "version": "0.1.0",
  "private": true,
  "description": "Digital twin + vision for a 4-DOF robot arm (chess pick & place). Configurable model, closed-form IK, three.js twin, pluggable hardware adapter.",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev:twin": "pnpm --filter twin dev",
    "dev:server": "pnpm --filter server dev",
    "dev:vision": "cd apps/vision && python3 -m vision"
  }
}
